APP_ENV=development
SECRET_KEY=replace-with-a-long-random-development-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5174
PUBLIC_APP_BASE_URL=http://localhost:5174
PASSPORT_RATE_LIMIT_PER_MINUTE=60

POSTGRES_USER=agrotwin
POSTGRES_PASSWORD=agrotwin
POSTGRES_DB=agrotwin
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/storage
# Production on Render free: use Cloudflare R2 (S3-compatible) — local disk is wiped on restart.
# STORAGE_BACKEND=s3
# S3_BUCKET=agrotwin
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

AI_PROVIDER=openai_compatible
AI_API_KEY=
# Gemini for Agronom (OpenAI-compatible endpoint). Same value as GEMINI_API_KEY.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_CHAT_MODEL=gemini-3.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_VISION_MODEL=gemini-3.5-flash
AI_EMBEDDING_DIM=1536
# When Gemini returns 503/high-demand, chat+vision fall through to OpenAI.
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o
OPENAI_API_KEY=

# Later switch to GPT-5:
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-5
# AI_VISION_MODEL=gpt-5
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_API_KEY=<OPENAI_API_KEY>

# Developer AI Model Benchmark (server-only; never expose to the frontend)
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_BENCHMARK_MODEL=gpt-5
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_BENCHMARK_BASE_URL=https://api.openai.com/v1
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_MAX_OUTPUT_TOKENS=2048
BENCHMARK_TIMEOUT_SECONDS=90
BENCHMARK_RATE_LIMIT_PER_MINUTE=10
BENCHMARK_GEMINI_INPUT_USD_PER_MTOK=0.75
BENCHMARK_GEMINI_OUTPUT_USD_PER_MTOK=3.75
BENCHMARK_OPENAI_INPUT_USD_PER_MTOK=1.25
BENCHMARK_OPENAI_OUTPUT_USD_PER_MTOK=10.0

YR_USER_AGENT=AgroTwin/1.0 (contact@agrotwin.com)

SOILGRIDS_BASE_URL=https://rest.isric.org
SOILGRIDS_USER_AGENT=AgroTwin/1.0 (contact@agrotwin.com)
SOILGRIDS_TIMEOUT_SECONDS=90
SOILGRIDS_CACHE_DAYS=30
SOILGRIDS_MIN_INTERVAL_SECONDS=12
SOILGRIDS_MIN_REFRESH_SECONDS=3600

# Parcel intelligence (reuses AI_PROVIDER / AI_API_KEY — never a second AI stack)
AI_INTELLIGENCE_ENABLED=true
AI_ANALYSIS_MIN_INTERVAL_HOURS=24
AI_INTELLIGENCE_NDVI_CHANGE_THRESHOLD=0.08

# Satellite monitoring (server-only credentials — never expose to frontend)
SATELLITE_PROVIDER=copernicus
# Use SATELLITE_PROVIDER=fake for local demos without CDSE credentials
SATELLITE_ENABLED=true
SATELLITE_LOOKBACK_DAYS=21
SATELLITE_CLOUD_THRESHOLDS=20,30,40
SATELLITE_ABSOLUTE_MAX_CLOUD=40
SATELLITE_ZONE_GRID_SIZE=4
SATELLITE_ANOMALY_BELOW_MEAN_FRACTION=0.15
SATELLITE_ANOMALY_SUDDEN_DECLINE_FRACTION=0.20
SATELLITE_MIN_INTERVAL_SECONDS=1
SATELLITE_HTTP_TIMEOUT_SECONDS=120
SATELLITE_NDRE_NIR_BAND=B8A
SATELLITE_NDRE_RED_EDGE_BAND=B05
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
COPERNICUS_OPENEO_URL=https://openeo.dataspace.copernicus.eu/openeo/1.2
# Put real values in backend/.env (this file is only a template).
# openEO requires a CDSE account that can call /me — many "sh-…" clients get a
# token but openEO returns TokenInvalid. Prefer username/password from
# https://dataspace.copernicus.eu/ (My Account), or an OIDC client with openEO access.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# Optional machine-to-machine (only if the client is accepted by openEO /me):
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_REFRESH_TOKEN=
