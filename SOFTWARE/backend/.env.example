APP_ENV=development
SECRET_KEY=replace-with-a-long-random-development-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5174

POSTGRES_USER=agrotwin
POSTGRES_PASSWORD=agrotwin
POSTGRES_DB=agrotwin
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/storage

AI_PROVIDER=openai_compatible
AI_API_KEY=
# Gemini 3.8 Flash for Agronom (OpenAI-compatible endpoint). Same value as GEMINI_API_KEY.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_CHAT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_VISION_MODEL=gemini-3.8-flash
AI_EMBEDDING_DIM=1536

# Later switch to GPT-5:
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-5
# AI_VISION_MODEL=gpt-5
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_API_KEY=<OPENAI_API_KEY>

# Developer AI Model Benchmark (server-only; never expose to the frontend)
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_BENCHMARK_MODEL=gpt-5
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_BENCHMARK_BASE_URL=https://api.openai.com/v1
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_MAX_OUTPUT_TOKENS=2048
BENCHMARK_TIMEOUT_SECONDS=90
BENCHMARK_RATE_LIMIT_PER_MINUTE=10
BENCHMARK_GEMINI_INPUT_USD_PER_MTOK=0.75
BENCHMARK_GEMINI_OUTPUT_USD_PER_MTOK=3.75
BENCHMARK_OPENAI_INPUT_USD_PER_MTOK=1.25
BENCHMARK_OPENAI_OUTPUT_USD_PER_MTOK=10.0

YR_USER_AGENT=AgroTwin/1.0 (contact@agrotwin.com)

SOILGRIDS_BASE_URL=https://rest.isric.org
SOILGRIDS_USER_AGENT=AgroTwin/1.0 (contact@agrotwin.com)
SOILGRIDS_TIMEOUT_SECONDS=90
SOILGRIDS_CACHE_DAYS=30
SOILGRIDS_MIN_INTERVAL_SECONDS=12
SOILGRIDS_MIN_REFRESH_SECONDS=3600
